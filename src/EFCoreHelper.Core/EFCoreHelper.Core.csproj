<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>EFCoreHelper.Core</RootNamespace>
    <AssemblyName>EFCoreHelper.Core</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Pishang Ujeniya</Authors>
    <Company>EFCoreHelper</Company>
    <Description>Core library for EFCore Helper - provides command generation, solution scanning, and CLI execution for Entity Framework Core.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

</Project>

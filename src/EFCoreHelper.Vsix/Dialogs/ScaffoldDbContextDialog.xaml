<platformUi:DialogWindow x:Class="EFCoreHelper.Vsix.Dialogs.ScaffoldDbContextDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                          xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                          Title="Scaffold DbContext (Reverse Engineering)"
                          Width="600" Height="580"
                          WindowStartupLocation="CenterOwner"
                          ShowInTaskbar="False"
                          ResizeMode="CanResizeWithGrip"
                          Background="{DynamicResource {x:Static shell:VsBrushes.WindowKey}}"
                          Foreground="{DynamicResource {x:Static shell:VsBrushes.WindowTextKey}}">

  <platformUi:DialogWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </platformUi:DialogWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Main Dialog Content -->
    <Grid Grid.Row="0" Margin="14,12,14,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Form Fields -->
      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Style="{DynamicResource {x:Static shell:VsResourceKeys.ScrollViewerStyleKey}}">
        <StackPanel>
          <TextBlock Text="Target project (Reverse engineering target):" Style="{StaticResource VsFieldLabelStyle}" />
          <ComboBox x:Name="CmbProject" Height="23" Style="{DynamicResource {x:Static shell:VsResourceKeys.ComboBoxStyleKey}}" Margin="0,0,0,10" SelectionChanged="OnFieldChanged" />

          <TextBlock Text="Startup project (Executable / Web app):" Style="{StaticResource VsFieldLabelStyle}" />
          <ComboBox x:Name="CmbStartupProject" Height="23" Style="{DynamicResource {x:Static shell:VsResourceKeys.ComboBoxStyleKey}}" Margin="0,0,0,10" SelectionChanged="OnFieldChanged" />

          <TextBlock Text="Database provider:" Style="{StaticResource VsFieldLabelStyle}" />
          <ComboBox x:Name="CmbProvider" IsEditable="True" Height="23" Style="{DynamicResource {x:Static shell:VsResourceKeys.ComboBoxStyleKey}}" Margin="0,0,0,10" SelectionChanged="OnProviderChanged" />

          <TextBlock Text="Connection string:" Style="{StaticResource VsFieldLabelStyle}" />
          <ComboBox x:Name="CmbConnectionString" IsEditable="True" Height="23" Style="{DynamicResource {x:Static shell:VsResourceKeys.ComboBoxStyleKey}}" Margin="0,0,0,10" SelectionChanged="OnFieldChanged" TextBoxBase.TextChanged="OnConnectionTextChanged" />

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Context name:" Style="{StaticResource VsFieldLabelStyle}" />
              <TextBox x:Name="TxtContextName" Text="AppDbContext" Height="23" Style="{DynamicResource {x:Static shell:VsResourceKeys.TextBoxStyleKey}}" TextChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Entities folder:" Style="{StaticResource VsFieldLabelStyle}" />
              <TextBox x:Name="TxtOutputDir" Text="Models" Height="23" Style="{DynamicResource {x:Static shell:VsResourceKeys.TextBoxStyleKey}}" TextChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Context folder:" Style="{StaticResource VsFieldLabelStyle}" />
              <TextBox x:Name="TxtContextDir" Text="Data" Height="23" Style="{DynamicResource {x:Static shell:VsResourceKeys.TextBoxStyleKey}}" TextChanged="OnFieldChanged" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Filter tables (comma-separated):" Style="{StaticResource VsFieldLabelStyle}" />
              <TextBox x:Name="TxtTables" Height="23" Style="{DynamicResource {x:Static shell:VsResourceKeys.TextBoxStyleKey}}" TextChanged="OnFieldChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Filter schemas (comma-separated):" Style="{StaticResource VsFieldLabelStyle}" />
              <TextBox x:Name="TxtSchemas" Height="23" Style="{DynamicResource {x:Static shell:VsResourceKeys.TextBoxStyleKey}}" TextChanged="OnFieldChanged" />
            </StackPanel>
          </Grid>

          <WrapPanel Margin="0,2,0,6">
            <CheckBox x:Name="ChkDataAnnotations" Content="Data annotations (--data-annotations)" Style="{DynamicResource {x:Static shell:VsResourceKeys.CheckBoxStyleKey}}" Margin="0,0,16,6" Checked="OnFieldChanged" Unchecked="OnFieldChanged" />
            <CheckBox x:Name="ChkDatabaseNames" Content="Keep database names (--use-database-names)" Style="{DynamicResource {x:Static shell:VsResourceKeys.CheckBoxStyleKey}}" Margin="0,0,16,6" Checked="OnFieldChanged" Unchecked="OnFieldChanged" />
            <CheckBox x:Name="ChkNoPluralize" Content="Don't pluralize (--no-pluralize)" Style="{DynamicResource {x:Static shell:VsResourceKeys.CheckBoxStyleKey}}" Margin="0,0,16,6" Checked="OnFieldChanged" Unchecked="OnFieldChanged" />
            <CheckBox x:Name="ChkForce" Content="Overwrite existing files (--force)" Style="{DynamicResource {x:Static shell:VsResourceKeys.CheckBoxStyleKey}}" Margin="0,0,16,6" Checked="OnFieldChanged" Unchecked="OnFieldChanged" />
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Command Line Preview -->
      <StackPanel Grid.Row="1" Margin="0,8,0,0">
        <TextBlock Text="Command preview:" Style="{StaticResource VsFieldLabelStyle}" />
        <TextBox x:Name="TxtCommandPreview" Style="{StaticResource CommandPreviewStyle}" Height="46" />
      </StackPanel>
    </Grid>

    <!-- Dialog Button Footer Bar -->
    <Border Grid.Row="1" Padding="14,10" Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarMenuBackgroundGradientKey}}" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.CommandBarBorderKey}}" BorderThickness="0,1,0,0">
      <Grid>
        <Button Content="Copy Command" HorizontalAlignment="Left" Click="OnCopyPreviewClicked" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Copy CLI command to clipboard" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnScaffold" Content="Scaffold" IsDefault="True" Click="OnScaffoldClicked" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Width="105" />
          <Button Content="Cancel" IsCancel="True" Click="OnCancelClicked" Style="{StaticResource SecondaryButtonStyle}" Width="75" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</platformUi:DialogWindow>

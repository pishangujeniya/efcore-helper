      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_SOLNNODE" />
    </CommandPlacement>
  </CommandPlacements>

  <KeyBindings>
    <KeyBinding guid="guidEFCoreHelperPackageCmdSet" id="cmdidOpenToolWindow" editor="guidVSStd97" key1="E" mod1="Control Alt" key2="M" />
  </KeyBindings>

